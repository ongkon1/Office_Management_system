# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# MySQL 8.4; use separate least-privilege users/databases per environment.
DATABASE_URL=mysql://office_app:replace-me@127.0.0.1:3306/office_management
# Privileged deployment account used by migrations, guarded recovery, and the
# non-production demo seeder. The production application never uses it.
# Do not expose this credential to the browser or use it as DATABASE_URL.
DATABASE_MIGRATION_URL=mysql://office_migrator:replace-me@127.0.0.1:3306/office_management
DATABASE_POOL_LIMIT=10
# Comma-separated runtime principals hardened after migrations, for example:
# office_app@localhost,office_app@127.0.0.1
# Never list root, a MySQL system account, or the migration account here.
RUNTIME_DATABASE_ACCOUNTS=

# Better Auth; generate unique values outside source control.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# BullMQ / Redis
REDIS_URL=redis://127.0.0.1:6379
# Production readiness requires active HR, export, notification, and supporting workers.
WORKER_READINESS_REQUIRED=false

# S3-compatible protected object storage
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=office-management-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=PowerInAI <no-reply@example.invalid>

# Multi-instance Next.js deployments
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DEPLOYMENT_VERSION=local

# Phase 6 export artifacts use the private S3 bucket above unless overridden.
EXPORT_S3_BUCKET=
# Absolute path to a licensed Unicode font file available in the worker image.
EXPORT_PDF_FONT_PATH=

# Backend Phase 7 — notifications, files, documents, messaging, search, API and integrations.
# Attachments use the private S3 bucket above; set a separate one if preferred.
ATTACHMENT_S3_BUCKET=
# Development only: where the local attachment store writes (ignored by git).
LOCAL_OBJECT_STORE_DIR=.data/objects
# Malware scanning. Without a scanner in production, uploads stay unavailable.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Integration secrets at rest: comma-separated id:base64(32 bytes), first is current.
# Generate with: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEYS=
# Calendar providers stay unavailable until listed here AND configured.
INTEGRATION_APPROVED_PROVIDERS=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=organizations

# Phase 8 encrypted backup and isolated restore drill. Keep the key in the
# deployment secret manager, never in source control or beside the backup.
BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
RESTORE_S3_BUCKET=
RESTORE_S3_PREFIX=
RESTORE_BACKUP_FILE=
RESTORE_DATABASE_URL=
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
