# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# MySQL 8.4; use separate least-privilege users/databases per environment.
DATABASE_URL=mysql://office_app:replace-me@127.0.0.1:3306/office_management
DATABASE_POOL_LIMIT=10

# Better Auth; generate unique values outside source control.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# BullMQ / Redis
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible protected object storage
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=office-management-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=PowerInAI <no-reply@example.invalid>

# Multi-instance Next.js deployments
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DEPLOYMENT_VERSION=local
